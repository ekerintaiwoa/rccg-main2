# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where your frontend is hosted.
APP_URL="MY_APP_URL"

# Backend API base URL used by the frontend.
# For local: http://127.0.0.1:8010
# For Hostinger: https://api.yourdomain.com
VITE_BACKEND_URL="http://127.0.0.1:8010"
